{
  "$schema": "https://aka.ms/vscode-mcp.schema.json",
  "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "GitHub fine-grained Personal Access Token (only if OAuth unavailable)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "atlassian_basic_auth",
      "description": "Base64(email:api_token) for Atlassian MCP (admin-controlled fallback)",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,issues,pull_requests,users",
        "X-MCP-Readonly": "true"
      }
    },
    "linear": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    },
    "atlassianConfluence": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    }
  }
}
