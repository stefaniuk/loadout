# ==============================================================================
# SEE: https://github.com/stefaniuk/loadout/blob/main/.gitignore.loadout

# ------------------------------------------------------------------------------
# GitHub Copilot configuration
# ------------------------------------------------------------------------------

# Agents (custom agent definitions or README placeholder)
.github/agents/

# Hooks (Copilot agent hooks, e.g. quality-gates.json)
.github/hooks/

# Instructions (shell, docker, makefile, readme, and technology-specific)
.github/instructions/

# Prompts (architecture, enforce, review, speckit, util)
.github/prompts/

# Skills (repository-template and technology-specific)
.github/skills/

# Copilot instructions file
.github/copilot-instructions.md

# ------------------------------------------------------------------------------
# Specify framework
# ------------------------------------------------------------------------------

# Constitution
.specify/memory/constitution.md

# Python scripts
.specify/scripts/python/

# Templates
.specify/templates/

# ------------------------------------------------------------------------------
# Cross-agent baseline and hook executables
# ------------------------------------------------------------------------------

# Hook executables invoked by .github/hooks/*.json
scripts/hooks/

# ------------------------------------------------------------------------------
# Documentation
# ------------------------------------------------------------------------------

# Pull request template (only copied if not present)
# .github/pull_request_template.md

# ADR template
docs/adr/ADR-nnn_Any_Decision_Record_Template.md
docs/adr/Tech_Radar.md

# Superpowers local planning and design artefacts
docs/superpowers/

# ------------------------------------------------------------------------------
# Workspace configuration
# ------------------------------------------------------------------------------

# Local active workflow selection (session/worktree scoped)
.copilot/workflow-mode.json
